ENVIRONMENT=development

PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900

PASSWORD_RESET_TTL_SECONDS=1800
EMAIL_VERIFICATION_TTL_SECONDS=86400

AUTH_SECURITY_REDIS_URL=redis://localhost:56380/2
SECURITY_TOKEN_PEPPER=CHANGE_ME_DEV_TOKEN_PEPPER
SECURITY_NOTIFICATION_ENCRYPTION_KEY=<generate-with-scripts/generate_security_keys.py>

TRUSTED_FRONTEND_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,identity-service,academic-service,attendance-service,scheduling-service,notification-service,facility-service,learning-service,assessment-service,reporting-service,platform-service,testserver

REFRESH_COOKIE_NAME=sep_refresh
REFRESH_COOKIE_PATH=/api/v1/identity/auth
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=strict
REFRESH_COOKIE_MAX_AGE_SECONDS=604800

REQUIRE_EMAIL_VERIFICATION=false

MAX_UPLOAD_BYTES=26214400
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=false
