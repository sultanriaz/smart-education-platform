# TEMPLATE ONLY. Secret values must come from the deployment secret store.
ENVIRONMENT=production

PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900

PASSWORD_RESET_TTL_SECONDS=1800
EMAIL_VERIFICATION_TTL_SECONDS=86400

AUTH_SECURITY_REDIS_URL=rediss://<durable-redis-host>:6379/2
SECURITY_TOKEN_PEPPER=<secret-ref>
SECURITY_NOTIFICATION_ENCRYPTION_KEY=<secret-ref>

TRUSTED_FRONTEND_ORIGINS=https://<frontend-domain>
TRUSTED_HOSTS=<internal-service-hostnames>

REFRESH_COOKIE_NAME=sep_refresh
REFRESH_COOKIE_PATH=/api/v1/identity/auth
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=strict
REFRESH_COOKIE_MAX_AGE_SECONDS=604800

REQUIRE_EMAIL_VERIFICATION=true

MAX_UPLOAD_BYTES=26214400
CLAMAV_HOST=<clamav-host>
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=true

# Gateway
LOGIN_RATE_LIMIT=10r/m
LOGIN_RATE_BURST=5
REFRESH_RATE_LIMIT=30r/m
REFRESH_RATE_BURST=10
RECOVERY_RATE_LIMIT=5r/m
RECOVERY_RATE_BURST=3

# Frontend
ENABLE_HSTS=true
