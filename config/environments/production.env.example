# TEMPLATE ONLY. Do not store actual secrets in this file.
ENVIRONMENT=production

DATABASE_URL=postgresql+psycopg://<service-user>:<secret>@<production-postgres>/<service-db>?sslmode=require
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT_SECONDS=20
DB_POOL_RECYCLE_SECONDS=1200
DB_STATEMENT_TIMEOUT_MS=10000
DB_APPLICATION_NAME=<service-name>-prod

REDIS_CACHE_URL=rediss://<cache-host>:6379/0
REDIS_DURABLE_URL=rediss://<durable-host>:6379/0
REDIS_KEY_PREFIX=smartedu:prod
IDEMPOTENCY_REDIS_URL=rediss://<durable-host>:6379/1

RABBITMQ_URL=amqps://<user>:<secret>@<broker-host>:5671/smartedu
EVENT_EXCHANGE=smartedu.events
DEAD_LETTER_EXCHANGE=smartedu.dlx
RETRY_EXCHANGE=smartedu.retry
EVENT_QUEUE_PREFIX=smartedu.prod
EVENT_PREFETCH_COUNT=50
EVENT_RETRY_DELAY_MS=5000
EVENT_MAX_DELIVERY_ATTEMPTS=5

S3_ENDPOINT_URL=https://<object-storage-endpoint>
S3_REGION=<region>
S3_ACCESS_KEY_ID=<secret-ref>
S3_SECRET_ACCESS_KEY=<secret-ref>
S3_USE_SSL=true
S3_ADDRESSING_STYLE=path
S3_PRESIGN_TTL_SECONDS=300

OUTBOX_RETENTION_DAYS=14
INBOX_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
NOTIFICATION_DELIVERY_RETENTION_DAYS=90
JOB_RETENTION_DAYS=30
