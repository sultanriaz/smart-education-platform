ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://<service-user>:<password>@localhost:55432/<service-db>
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=15000
DB_APPLICATION_NAME=<service-name>

REDIS_CACHE_URL=redis://localhost:56379/0
REDIS_DURABLE_URL=redis://localhost:56380/0
REDIS_KEY_PREFIX=smartedu:dev
IDEMPOTENCY_REDIS_URL=redis://localhost:56380/1

RABBITMQ_URL=amqp://smartedu:<password>@localhost:5672/smartedu
EVENT_EXCHANGE=smartedu.events
DEAD_LETTER_EXCHANGE=smartedu.dlx
RETRY_EXCHANGE=smartedu.retry
EVENT_QUEUE_PREFIX=smartedu.dev
EVENT_PREFETCH_COUNT=20
EVENT_RETRY_DELAY_MS=5000
EVENT_MAX_DELIVERY_ATTEMPTS=5

S3_ENDPOINT_URL=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=<local-minio-user>
S3_SECRET_ACCESS_KEY=<local-minio-password>
S3_USE_SSL=false
S3_ADDRESSING_STYLE=path
S3_PRESIGN_TTL_SECONDS=900
