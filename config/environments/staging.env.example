# Values are examples/placeholders. Inject secrets from CI/CD secret storage.
ENVIRONMENT=staging

DATABASE_URL=postgresql+psycopg://<service-user>:<secret>@<staging-postgres>/<service-db>
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=20
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=12000
DB_APPLICATION_NAME=<service-name>-staging

REDIS_CACHE_URL=rediss://<cache-host>:6379/0
REDIS_DURABLE_URL=rediss://<durable-host>:6379/0
REDIS_KEY_PREFIX=smartedu:staging
IDEMPOTENCY_REDIS_URL=rediss://<durable-host>:6379/1

RABBITMQ_URL=amqps://<user>:<secret>@<broker-host>:5671/smartedu-staging
EVENT_EXCHANGE=smartedu.events
DEAD_LETTER_EXCHANGE=smartedu.dlx
RETRY_EXCHANGE=smartedu.retry
EVENT_QUEUE_PREFIX=smartedu.staging
EVENT_PREFETCH_COUNT=20
EVENT_RETRY_DELAY_MS=5000
EVENT_MAX_DELIVERY_ATTEMPTS=5

S3_ENDPOINT_URL=https://<object-storage-endpoint>
S3_REGION=<region>
S3_ACCESS_KEY_ID=<secret-ref>
S3_SECRET_ACCESS_KEY=<secret-ref>
S3_USE_SSL=true
S3_ADDRESSING_STYLE=path
S3_PRESIGN_TTL_SECONDS=600
