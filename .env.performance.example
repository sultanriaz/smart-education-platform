SMARTEDU_GATEWAY_URL=http://host.docker.internal:8080
SMARTEDU_FRONTEND_ORIGIN=http://localhost:3000

# Prefer credentials for soak runs so access-token refresh is exercised.
SMARTEDU_PERF_STUDENT_EMAIL=<qa-student-email>
SMARTEDU_PERF_STUDENT_PASSWORD=<secret>
SMARTEDU_PERF_TEACHER_EMAIL=<qa-teacher-email>
SMARTEDU_PERF_TEACHER_PASSWORD=<secret>
SMARTEDU_PERF_ADMIN_EMAIL=<qa-admin-email>
SMARTEDU_PERF_ADMIN_PASSWORD=<secret>

# Optional short-run alternative:
SMARTEDU_STUDENT_TOKEN=
SMARTEDU_TEACHER_TOKEN=
SMARTEDU_ADMIN_TOKEN=

LOCUST_IMAGE=locustio/locust:2.32.3
PERF_USERS=100
PERF_SPAWN_RATE=10
PERF_RUN_TIME=300s
PERF_WORKERS=4
