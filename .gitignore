# ==========================================
# Backend: Python, FastAPI, SQLAlchemy
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
.venv/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Celery / Background Workers
celerybeat-schedule
celerybeat.pid
celerybeat-schedule.db
celerybeat-schedule.bak
celerybeat-schedule.dir

# Database (Local SQLite fallbacks, if any)
*.db
*.sqlite3

# ==========================================
# Frontend: React, Vite, TypeScript
# ==========================================
# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
dist-ssr/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript / Linting
*.tsbuildinfo
.eslintcache

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
.secrets/
# Keep the example file so the team knows what variables are needed
!.env.example 

# ==========================================
# Infrastructure: Docker & Operations
# ==========================================
# Ignore local compose overrides (keeps developers' custom mappings out of source control)
docker-compose.override.yml
.docker/

# ==========================================
# IDEs and Editors
# ==========================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iws
*.iml
*.ipr

# Vim / Emacs
*~
*.swp
*.swo

# ==========================================
# Operating System Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db

# Integration inputs, checkpoints and generated evidence
/.integration/
/sprint-zips/
/sprint_*.zip
artifacts/
test-results/
playwright-report/
.ruff_cache/
*.egg-info/
