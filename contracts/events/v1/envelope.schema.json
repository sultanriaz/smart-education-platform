{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-education.local/contracts/events/v1/envelope.schema.json",
  "title": "Smart Education Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "source",
    "occurred_at",
    "correlation_id",
    "data",
    "metadata"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "actor_user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "subject": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 240
    },
    "data": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  }
}
