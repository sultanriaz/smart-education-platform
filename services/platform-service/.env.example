APP_NAME=Smart Education Platform Operations Service
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5443/platform_db
REDIS_URL=redis://localhost:6381/0

JWT_JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=smart-education-api
JWT_ALGORITHMS=["RS256"]
JWKS_CACHE_SECONDS=300
JWKS_STALE_GRACE_SECONDS=900

INTERNAL_EVENT_TOKEN=change-me
SERVICE_INTERNAL_TOKEN=change-me

DEFAULT_SERVICE_TIMEOUT_SECONDS=3
SEARCH_MAX_RESULTS=100
SUPPORT_DEFAULT_PRIORITY=MEDIUM
JOB_MAX_RETRIES=3
