APP_NAME=Smart Education Identity Service
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://identity:identity@localhost:5434/identity_db
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_FILE=.secrets/identity-private.pem
JWT_KEY_ID=identity-dev-1
JWT_PREVIOUS_PUBLIC_KEYS={}
JWT_ISSUER=http://localhost:8001
JWT_ACCESS_AUDIENCE=smart-education-api
JWT_REFRESH_AUDIENCE=identity-service
JWT_LEEWAY_SECONDS=5
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=["http://localhost:5173"]
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_NAME=Platform Administrator
