APP_NAME=Smart Education Notification Service
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://notification:notification@localhost:5438/notification_db

JWT_JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=smart-education-api
JWT_ALGORITHM=RS256
JWT_JWKS_CACHE_SECONDS=300
JWT_JWKS_STALE_SECONDS=900

IDENTITY_SERVICE_BASE_URL=http://localhost:8001
IDENTITY_SERVICE_TIMEOUT_SECONDS=5
IDENTITY_SERVICE_TOKEN=
ACADEMIC_SERVICE_BASE_URL=http://localhost:8002
ACADEMIC_SERVICE_TIMEOUT_SECONDS=5
ACADEMIC_SERVICE_TOKEN=
ACADEMIC_SECTION_ROSTER_PATH_TEMPLATE=/api/v1/sections/{section_id}/roster

INTERNAL_EVENT_TOKEN=CHANGE_ME_INTERNAL_EVENT_TOKEN

TASK_MODE=inline
REDIS_URL=redis://localhost:6380/0

EMAIL_PROVIDER=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.edu
SMTP_USE_TLS=false

DEFAULT_EMAIL_ENABLED=false
DEFAULT_IN_APP_ENABLED=true
MAX_PAGE_SIZE=200
