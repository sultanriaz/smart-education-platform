APP_NAME=Smart Education Learning Service
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://learning:learning@localhost:5440/learning_db

JWT_JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=smart-education-api
JWT_ALGORITHMS=["RS256"]
JWT_JWKS_CACHE_TTL_SECONDS=300

ACADEMIC_SERVICE_BASE_URL=http://localhost:8002
ACADEMIC_SERVICE_TIMEOUT_SECONDS=5
ACADEMIC_INTERNAL_TOKEN=change-me-academic-internal-token

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/objects
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_MIME_TYPES=["application/pdf","text/plain","image/png","image/jpeg","application/vnd.openxmlformats-officedocument.wordprocessingml.document","application/vnd.openxmlformats-officedocument.presentationml.presentation"]

S3_ENDPOINT_URL=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=learning-resources
S3_ACCESS_KEY=learningadmin
S3_SECRET_KEY=learningsecret
S3_USE_SSL=false

NOTIFICATION_SERVICE_BASE_URL=http://localhost:8005
NOTIFICATION_INTERNAL_EVENT_TOKEN=change-me-notification-internal-token
OUTBOX_BATCH_SIZE=50

RECOMMENDATION_RECENT_DAYS=14
