APP_NAME=Smart Education Facility Service
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://facility:facility@localhost:5439/facility_db

JWT_JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=smart-education-api
JWT_ALGORITHM=RS256
JWT_JWKS_CACHE_SECONDS=300
JWT_JWKS_STALE_SECONDS=900

INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_SERVICE_TOKEN
NOTIFICATION_SERVICE_BASE_URL=http://localhost:8005
NOTIFICATION_INTERNAL_EVENT_TOKEN=CHANGE_ME_NOTIFICATION_INTERNAL_EVENT_TOKEN
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_INTERVAL_SECONDS=2

MAX_BOOKING_DURATION_HOURS=8
MIN_BOOKING_NOTICE_MINUTES=0
CANCELLATION_CUTOFF_MINUTES=30
PENDING_BOOKINGS_RESERVE_SLOT=true
MAX_PAGE_SIZE=200
