APP_NAME=Smart Education Reporting Service
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://reporting:reporting@localhost:5442/reporting_db

JWT_JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=smart-education-api
JWT_ALGORITHMS=["RS256"]
JWKS_CACHE_SECONDS=300

INTERNAL_EVENT_TOKEN=change-me

REPORTING_TIMEZONE=UTC
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
