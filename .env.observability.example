GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA
GRAFANA_ROOT_URL=http://localhost:3001
GRAFANA_COOKIE_SECURE=false

PROMETHEUS_RETENTION=35d
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
LOKI_PORT=3100
TEMPO_HTTP_PORT=3200
OTEL_GRPC_PORT=14317
OTEL_HTTP_PORT=14318

# Image pins should be updated through normal dependency/security review.
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.0
GRAFANA_IMAGE=grafana/grafana:11.4.0
LOKI_IMAGE=grafana/loki:3.2.1
PROMTAIL_IMAGE=grafana/promtail:3.2.1
TEMPO_IMAGE=grafana/tempo:2.6.1
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.114.0
