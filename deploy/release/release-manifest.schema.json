{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "release_tag",
    "commit_sha",
    "generated_at",
    "source_repository",
    "images",
    "migration_policy",
    "migration_components"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release_tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "generated_at": {
      "type": "string"
    },
    "source_repository": {
      "type": "string",
      "minLength": 3
    },
    "migration_policy": {
      "enum": [
        "forward-only",
        "explicit-reversible"
      ]
    },
    "migration_components": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "component",
          "repository",
          "digest",
          "immutable_ref"
        ],
        "properties": {
          "component": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{64}$"
          },
          "immutable_ref": {
            "type": "string",
            "pattern": "@sha256:[0-9a-fA-F]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
