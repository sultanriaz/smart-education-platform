FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN groupadd --system --gid 10001 smartedu \
    && useradd --system --uid 10001 --gid smartedu \
       --home-dir /nonexistent --shell /usr/sbin/nologin smartedu

# Install dependencies in build layers before dropping privileges.
# COPY shared wheels + service requirements here.

COPY --chown=smartedu:smartedu app ./app

USER 10001:10001

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
