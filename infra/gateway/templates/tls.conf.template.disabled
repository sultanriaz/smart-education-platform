# Rename/mount this as a normal conf file only when TLS certificates are provisioned.
# This is intentionally disabled in the default local stack.

server {
    listen 8443 ssl http2;
    server_name ${TLS_SERVER_NAME};

    ssl_certificate     /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Production integration should mirror the public API locations from
    # default.conf.template or terminate TLS at a load balancer before this gateway.
}
